generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounting_invoice_lines {
  id                    BigInt              @id @default(autoincrement())
  accounting_invoice_id BigInt
  description           String?             @db.VarChar(500)
  quantity              Decimal?            @db.Decimal(12, 2)
  unit_price            Decimal?            @db.Decimal(12, 2)
  amount                Decimal?            @db.Decimal(12, 2)
  service_date          DateTime?           @db.Date
  pickup_address        String?             @db.VarChar(500)
  drop_address_1        String?             @db.VarChar(500)
  drop_address_2        String?             @db.VarChar(500)
  drop_address_3        String?             @db.VarChar(500)
  sort_order            Int                 @default(0)
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  accounting_invoices   accounting_invoices @relation(fields: [accounting_invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([accounting_invoice_id], map: "idx_accounting_invoice_lines_invoice")
}

model accounting_invoices {
  id                       BigInt                     @id @default(autoincrement())
  company                  String                     @db.VarChar(20)
  master_order_number      String?                    @db.VarChar(100)
  order_number             String?                    @db.VarChar(100)
  contract_date            DateTime?                  @db.Date
  contract_price           Decimal?                   @db.Decimal(12, 2)
  broker_load_number       String?                    @db.VarChar(100)
  billing_category         String?                    @db.VarChar(50)
  tonu                     Boolean                    @default(false)
  invoice_number           String                     @unique @db.VarChar(50)
  invoice_date             DateTime?                  @db.Date
  date_range_start         DateTime?                  @db.Date
  date_range_end           DateTime?                  @db.Date
  invoice_price            Decimal?                   @db.Decimal(12, 2)
  check_date               DateTime?                  @db.Date
  check_amount             Decimal?                   @db.Decimal(12, 2)
  check_number             String?                    @db.VarChar(100)
  deduction                String?                    @db.VarChar(200)
  rts                      String?                    @db.VarChar(200)
  difference               String?                    @db.VarChar(200)
  notes                    String?
  bill_to                  String?                    @db.VarChar(200)
  description              String?
  quantity                 Decimal?                   @db.Decimal(12, 2)
  unit_price               Decimal?                   @db.Decimal(12, 2)
  pickup_date              DateTime?                  @db.Date
  pickup_company           String?                    @db.VarChar(200)
  pickup_address           String?                    @db.VarChar(300)
  drop_date                DateTime?                  @db.Date
  drop_company             String?                    @db.VarChar(200)
  drop_address             String?                    @db.VarChar(300)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  created_by               BigInt?
  updated_by               BigInt?
  accounting_invoice_lines accounting_invoice_lines[]
  accounting_invoice_reconciliations accounting_invoice_reconciliations[]
  invoice_template_id      BigInt?
  renderer_key             String?                     @db.VarChar(50)
  invoice_template         invoice_templates? @relation(fields: [invoice_template_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([check_date], map: "idx_accounting_invoices_check_date")
  @@index([company], map: "idx_accounting_invoices_company")
  @@index([invoice_date], map: "idx_accounting_invoices_invoice_date")
  @@index([invoice_template_id], map: "idx_accounting_invoices_template")
}

model accounting_invoice_reconciliations {
  id                    BigInt              @id @default(autoincrement())
  accounting_invoice_id BigInt
  request_id            String              @unique @db.VarChar(100)
  check_date            DateTime            @db.Date
  check_amount          Decimal             @db.Decimal(12, 2)
  check_number          String              @db.VarChar(100)
  notes                 String?             @db.VarChar(500)
  voided_at             DateTime?           @db.Timestamptz(6)
  voided_by             BigInt?
  void_reason           String?             @db.VarChar(500)
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  updated_at            DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  created_by            BigInt?
  updated_by            BigInt?
  accounting_invoice    accounting_invoices @relation(fields: [accounting_invoice_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([accounting_invoice_id, voided_at], map: "idx_reconciliations_invoice_active")
  @@index([check_date], map: "idx_reconciliations_check_date")
  @@index([check_number], map: "idx_reconciliations_check_number")
}

model land_orders {
  id               BigInt             @id @default(autoincrement())
  identifier       String?            @db.VarChar(50)
  operating_company String             @db.VarChar(100)
  dispatch_person  String?            @db.VarChar(100)
  broker           String?            @db.VarChar(100)
  load_number      String?            @db.VarChar(100)
  quantity         Decimal?           @db.Decimal(10, 2)
  pallet_positions Decimal?           @db.Decimal(10, 2)
  weight_lbs       Decimal?           @db.Decimal(12, 2)
  price            Decimal?           @db.Decimal(12, 2)
  load_type        String             @default("full") @db.VarChar(20)
  delivery_person  String?            @db.VarChar(100)
  /// 订单自身生命周期；排车执行状态在 land_dispatch_items.status 独立维护
  status           String             @default("draft") @db.VarChar(20)
  note             String?            @db.VarChar(500)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  created_by       BigInt?
  updated_by       BigInt?
  land_order_stops land_order_stops[]
  land_dispatch_items land_dispatch_items[]

  @@index([operating_company], map: "idx_land_orders_operating_company")
  @@index([status], map: "idx_land_orders_status")
  @@index([created_at], map: "idx_land_orders_created_at")
  @@index([identifier], map: "idx_land_orders_identifier")
}

model land_order_stops {
  id                BigInt      @id @default(autoincrement())
  land_order_id     BigInt
  stop_type         String      @db.VarChar(10)
  sequence          Int
  company_name      String      @db.VarChar(200)
  address           String?     @db.VarChar(500)
  city              String      @db.VarChar(100)
  state             String      @db.VarChar(50)
  zip_code          String?     @db.VarChar(20)
  stop_date         DateTime    @db.Date
  time_from         String?     @db.VarChar(5)
  time_to           String?     @db.VarChar(5)
  time_type         String?     @default("FCFS") @db.VarChar(30)
  reference_numbers String?     @db.VarChar(500)
  stop_note         String?     @db.VarChar(500)
  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  updated_at        DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  land_orders       land_orders @relation(fields: [land_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([land_order_id, sequence], map: "uk_land_order_stops_order_sequence")
  @@index([land_order_id, stop_type], map: "idx_land_order_stops_order_type")
  @@index([stop_date], map: "idx_land_order_stops_date")
}

model land_dispatch_items {
  id              BigInt       @id @default(autoincrement())
  land_order_id   BigInt       @unique
  dispatch_date   DateTime     @db.Date
  truck           String?      @db.VarChar(50)
  driver          String?      @db.VarChar(100)
  trailer         String?      @db.VarChar(100)
  haul_type       String       @default("long_haul") @db.VarChar(20)
  /// 排车执行状态；不回写或替代 land_orders.status
  status          String       @default("planned") @db.VarChar(20)
  todo_note       String?      @db.VarChar(500)
  todo_done       Boolean      @default(false)
  sort_order      Int          @default(0)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  created_by      BigInt?
  updated_by      BigInt?
  land_orders     land_orders  @relation(fields: [land_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([dispatch_date], map: "idx_land_dispatch_items_date")
  @@index([truck], map: "idx_land_dispatch_items_truck")
  @@index([driver], map: "idx_land_dispatch_items_driver")
  @@index([status], map: "idx_land_dispatch_items_status")
  @@index([haul_type], map: "idx_land_dispatch_items_haul_type")
}

model users {
  id            BigInt       @id @default(autoincrement())
  username      String       @unique @db.VarChar(50)
  password_hash String
  name          String?      @db.VarChar(100)
  role          String       @default("user") @db.VarChar(50)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  table_views   table_views[]
}

/** 表格视图预设：按用户按表格保存（筛选 + 排序 + 列显隐 + 分组顺序） */
model table_views {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  table_key  String   @db.VarChar(50)
  name       String   @db.VarChar(50)
  config     Json
  is_default Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, table_key, name], map: "uk_table_views_user_table_name")
  @@index([user_id, table_key], map: "idx_table_views_user_table")
}

model companies {
  id             BigInt            @id @default(autoincrement())
  code           String            @unique @db.VarChar(20)
  name           String            @db.VarChar(100)
  invoice_prefix String?           @db.VarChar(10)
  is_active      Boolean           @default(true)
  created_at     DateTime          @default(now()) @db.Timestamptz(6)
  updated_at     DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  invoice_templates invoice_templates[]
}

model invoice_templates {
  id             BigInt    @id @default(autoincrement())
  company_id     BigInt
  name           String    @db.VarChar(100)
  status         String    @default("draft") @db.VarChar(20)
  is_default     Boolean   @default(false)
  page_config    Json
  grid_config    Json
  binding_config Json
  created_by     BigInt?
  updated_by     BigInt?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  company        companies @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  accounting_invoices accounting_invoices[]

  @@index([company_id, status], map: "idx_invoice_templates_company_status")
  @@index([company_id, is_default], map: "idx_invoice_templates_company_default")
}
